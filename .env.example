# LCA-GPT Enterprise — Environment Variables configuration
# Copy this file to '.env' and fill in your actual credentials.

# ─── PostgreSQL (persistent audit storage) ──────────────────────────
# Required for multi-user accounts + persistent audits. Any Neon/Postgres URL works.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Secret database viewer (/db-view) ────────────────────────────────
# Protects the admin page that shows ALL audits. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_DATA_KEY=your_secret_key

# ─── OpenRouter LLM Configuration ─────────────────────────────────────
# API Key for OpenRouter to query the selected AI model.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# ─── Groq Fast Inference (primary LLM provider) ───────────────────────────────
# When GROQ_API_KEY is set, Groq is used instead of OpenRouter.
# Get a free key at https://console.groq.com — no credit card required.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# ─── Serper.dev Google Search Configuration ───────────────────────────
# Used for real-time emission factor lookups and verification.
SERPER_API_KEY=your_serper_api_key

# ─── CORS ─────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API (dev default: localhost).
CORS_ORIGINS=http://localhost:5173,http://localhost:8501
